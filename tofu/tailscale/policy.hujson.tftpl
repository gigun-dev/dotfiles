{
	"tagOwners": {
		"tag:admin-device": [${owner}],
		"tag:client":       [${owner}],
		"tag:storage":      [${owner}],
		"tag:proxmox":      [${owner}],
		"tag:server":       [${owner}],
	},

	"nodeAttrs": [
		{"target": ["tag:storage"], "attr": ["drive:share"]},
		{"target": ["tag:admin-device"], "attr": ["drive:access"]},
	],

	"grants": [
		// tag 同士の IP 全許可（homelab なので細粒度せず）
		{
			"src":
				[
					"tag:admin-device",
					"tag:client",
					"tag:storage",
					"tag:proxmox",
					"tag:server",
				],
			"dst":
				[
					"tag:admin-device",
					"tag:client",
					"tag:storage",
					"tag:proxmox",
					"tag:server",
				],
			"ip": ["*"],
		},
		// Taildrive: admin-device からのみ storage を read/write
		{
			"src": ["tag:admin-device"],
			"dst": ["tag:storage"],
			"app": {
				"tailscale.com/cap/drive": [
					{"shares": ["*"], "access": "rw"},
				],
			},
		},
	],

	"ssh": [
		// admin → Linux サーバ群: root と ubuntu (運用必要)
		{
			"action": "accept",
			"src":    ["tag:admin-device"],
			"dst":    ["tag:proxmox", "tag:server"],
			"users":  ["root", "ubuntu"],
		},
		// admin → 自分で使う端末: nonroot のみ (`ssh gigun@mini` 想定)
		{
			"action": "accept",
			"src":    ["tag:admin-device"],
			"dst":    ["tag:admin-device", "tag:client", "tag:storage"],
			"users":  ["autogroup:nonroot"],
		},
		// storage → proxmox: mini から pve のディスク退避を行うため (root)
		{
			"action": "accept",
			"src":    ["tag:storage"],
			"dst":    ["tag:proxmox"],
			"users":  ["root"],
		},
		// admin → mini-vm (エージェント基盤): gigun で常用する
		{
			"action": "accept",
			"src":    ["tag:admin-device"],
			"dst":    ["tag:server"],
			"users":  ["autogroup:nonroot"],
		},
	],
	"tests": [
		// タグ無しの本人端末から tag:server の ssh へは入れない
		{
			"src": ${owner},
			"deny": ["tag:server:22"],
		},
		{
			"src": "tag:admin-device",
			"accept": ["tag:server:22"],
		},
	],
}
