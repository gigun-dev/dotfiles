{
	"tagOwners": {
		"tag:admin-device": [${owner}],
		"tag:client":       [${owner}],
		"tag:storage":      [${owner}],
		"tag:proxmox":      [${owner}],
		"tag:dev":          [${owner}],
	},

	"nodeAttrs": [
		{"target": ["tag:storage"], "attr": ["drive:share"]},
		{"target": ["tag:admin-device"], "attr": ["drive:access"]},
	],

	"grants": [
		// tag 同士の IP 全許可（homelab なので細粒度せず）
		{
			"src":
				[
					"tag:admin-device",
					"tag:client",
					"tag:storage",
					"tag:proxmox",
					"tag:dev",
				],
			"dst":
				[
					"tag:admin-device",
					"tag:client",
					"tag:storage",
					"tag:proxmox",
					"tag:dev",
				],
			"ip": ["*"],
		},
		// Taildrive: admin-device からのみ storage を read/write
		{
			"src": ["tag:admin-device"],
			"dst": ["tag:storage"],
			"app": {
				"tailscale.com/cap/drive": [
					{"shares": ["*"], "access": "rw"},
				],
			},
		},
	],

	"ssh": [
		// admin → pve: root と ubuntu (運用必要)
		{
			"action": "accept",
			"src":    ["tag:admin-device"],
			"dst":    ["tag:proxmox"],
			"users":  ["root", "ubuntu"],
		},
		// admin → 自分で使う端末: nonroot のみ (`ssh gigun@mini` 想定)
		{
			"action": "accept",
			"src":    ["tag:admin-device"],
			"dst":    ["tag:admin-device", "tag:client", "tag:storage"],
			"users":  ["autogroup:nonroot"],
		},
		// admin → 開発環境: nonroot で常用する
		{
			"action": "accept",
			"src":    ["tag:admin-device"],
			"dst":    ["tag:dev"],
			"users":  ["autogroup:nonroot"],
		},
		// mini-vm と mini は一組の開発環境。通常ユーザーで相互に処理を渡す。
		{
			"action": "accept",
			"src":    ["tag:dev"],
			"dst":    ["tag:dev"],
			"users":  ["gigun"],
		},
	],
	"sshTests": [
		{"src": "tag:dev", "dst": ["tag:dev"], "accept": ["gigun"], "deny": ["root"]},
		{"src": "tag:admin-device", "dst": ["tag:dev"], "accept": ["gigun"]},
		{"src": "tag:client", "dst": ["tag:dev"], "deny": ["gigun", "root"]},
	],
	"tests": [
		// タグ無しの本人端末から tag:dev の ssh へは入れない
		{
			"src":  ${owner},
			"deny": ["tag:dev:22"],
		},
		{
			"src":    "tag:admin-device",
			"accept": ["tag:dev:22"],
		},
	],
}
