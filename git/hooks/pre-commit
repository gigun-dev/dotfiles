#!/usr/bin/env bash
# commit 直前に staged の内容だけを整形し (treefmt)、秘密の混入を検査する (gitleaks)。
# ryoppippi/dotfiles の git-hooks.nu pre-commit と同じ流れ。
# nix が無ければ静かにスキップ (部分 bootstrap)。
set -uo pipefail

command -v nix >/dev/null 2>&1 || exit 0

mapfile -d '' -t staged < <(git diff --cached --name-only --diff-filter=ACMR -z)
mapfile -d '' -t deleted < <(git diff --cached --name-only --diff-filter=D -z)
# 削除だけの commit でも検査対象になりうるので、空判定は両方を見る。
[ "${#staged[@]}" -eq 0 ] && [ "${#deleted[@]}" -eq 0 ] && exit 0

# 未 stage / untracked を退避し、整形が staged 以外の編集を commit に巻き込まないようにする。
# --keep-index でないと index まで巻き戻る。旧実装は `git stash create -- <paths>` の
# pathspec が効かず全体を退避し、`stash apply || true` で失敗を握りつぶして
# unstaged hunk を失った (2026-11-08)。
stashed=0
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  git stash push --quiet --keep-index --include-untracked || exit 1
  stashed=1
fi

fmt_rc=0
leak_rc=0
nix fmt >&2 || fmt_rc=$?

# 整形で書き換わりうる元 staged パスだけを stage し直す (配列なので空白入りパスも安全)。
present=()
for path in "${staged[@]}"; do
  [ -e "$path" ] && present+=("$path")
done
[ "${#present[@]}" -gt 0 ] && { git add -- "${present[@]}" || fmt_rc=1; }

nix run .#gitleaks -- git --pre-commit --staged --redact=100 --verbose --no-color --no-banner >&2 \
  || leak_rc=$?

# ryoppippi と同じく pop で戻す。整形が staged の内容を書き換えたファイルは、退避中に
# unstaged の変更が 1 つでもあると pop で衝突する (stash の worktree 側は整形前の staged 分も
# 含むため)。衝突しても git は stash を消さないので変更は失われない。黙って commit を
# 通さず止める (ryoppippi は pop の失敗を見ていない)。先に `nix fmt` してから stage すれば起きない。
if [ "$stashed" -eq 1 ] && ! git stash pop --quiet; then
  {
    echo "pre-commit: 退避した unstaged 変更を pop で戻せなかった (整形との衝突)。変更は stash@{0} に残っている。"
    echo "復旧: 衝突したファイルを直してから git stash drop する。次からは nix fmt してから stage する。"
  } >&2
  exit 1
fi

[ "$fmt_rc" -ne 0 ] && { echo "pre-commit: treefmt が失敗した" >&2; exit 1; }
[ "$leak_rc" -ne 0 ] && { echo "pre-commit: gitleaks が失敗した" >&2; exit 1; }
exit 0
