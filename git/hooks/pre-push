#!/bin/sh
# =============================================================================
# pre-push フック — main への push のときだけ、CI と同一の検証を手元で実行する
# =============================================================================
#
# 【なぜ pre-push か / 何を守るか】
#   守りたいのは「悪意」ではなく「壊れたコードを事故で main に push すること」。
#   main の branch protection は repo admin (= 自分 / Claude Code) の直 push で
#   バイパスできる (todo.txt の old:DF-40) ので、いま実際に効いている歯止めは
#   このフックだけ。old:DF-40 を閉じるまで外さないこと。
#
#   pre-commit ではなく pre-push なのは、手元のコミットは細かく刻みたい一方で、
#   共有される瞬間 (push) だけ品質を保証すれば十分だから。
#
# 【スコープ】main への push のときだけ走らせる (feature ブランチは CI に任せ、
#   手元は軽く保つ)。緊急時は `git push --no-verify` で意図的にスキップできる
#   —— 回避は「明示的に --no-verify を打ったときだけ」という設計。
#
# 【検証の中身はここに書かない】scripts/verify.sh が持つ。CI (nix-build.yaml) と
#   同じスクリプトを指すことで、片方だけ直したときの食い違いを構造的に無くす。
#   → docs/adr/0002-run-the-ci-check-from-pre-push-via-scripts-verify.md
#
# 【配置が .githooks ではなく git/hooks なのはなぜか】
#   このリポジトリは既に core.hooksPath = git/hooks で pre-commit (staged な .nix の
#   nix fmt 自動整形) を動かしている。core.hooksPath は 1 つしか持てないので、
#   .githooks へ切り替えるとその pre-commit が無言で死ぬ。既存側に合わせた。
#
# 【有効化】core.hooksPath は .git/config に入るため git 管理されず、
#   **clone ごとに 1 回必要**:  git config core.hooksPath git/hooks
#
# 【関門の自己テスト】VERIFY_FORCE_FAIL=1 git push …  で必ず失敗させられる。
#   本番と同じ経路 (この exec) を通るので、「失敗が push を止めるか」を実測できる。
# =============================================================================

checked_ref=refs/heads/main
run_check=0

# stdin: "<local ref> <local sha> <remote ref> <remote sha>" が push される ref ごとに来る。
# ここで読み尽くすので、後続の処理を足すときは stdin が空になっていることに注意。
while read -r local_ref local_sha remote_ref remote_sha; do
	# ブランチ削除 (local_sha が全ゼロ) は検査対象外。
	case "$local_sha" in
		*[!0]*) : ;;      # 非ゼロを含む = 通常の push → 判定続行
		*) continue ;;    # 全ゼロ = 削除 → skip
	esac
	if [ "$remote_ref" = "$checked_ref" ]; then
		run_check=1
	fi
done

[ "$run_check" -eq 1 ] || exit 0

echo "pre-push: $checked_ref へ push するため検証を実行します…" >&2

# exec で置き換えることで、検証の終了コードがそのまま Git へ返る。
# Why not `if ! ...; then`: 複合コマンドを `!` に掛けるときのグループ化を誤ると
# 検証失敗が握りつぶされる (旧実装で実際に起きた)。exec なら間違えようがない。
exec "$(git rev-parse --show-toplevel)/scripts/verify.sh"
