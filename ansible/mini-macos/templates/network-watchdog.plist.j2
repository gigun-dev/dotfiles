<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>NET_WATCHDOG_DIR</key>
		<string>{{ mini_watchdog_log_dir }}</string>
		<key>NET_WATCHDOG_NO_REMEDIATE</key>
		<string>1</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>{{ mini_watchdog_label }}</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{ mini_watchdog_app_dir }}/network-watchdog.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>{{ mini_watchdog_log_dir }}/daemon.err</string>
	<key>StartInterval</key>
	<integer>30</integer>
</dict>
</plist>
