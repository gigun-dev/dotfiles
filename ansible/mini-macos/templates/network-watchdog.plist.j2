<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.gigun.net-watchdog</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>{{ mini_home }}/Library/Application Support/net-watchdog/network-watchdog.sh</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>NET_WATCHDOG_DIR</key><string>{{ mini_home }}/Library/Logs/net-watchdog</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>30</integer>
  <key>StandardErrorPath</key><string>{{ mini_home }}/Library/Logs/net-watchdog/daemon.err</string>
</dict></plist>
