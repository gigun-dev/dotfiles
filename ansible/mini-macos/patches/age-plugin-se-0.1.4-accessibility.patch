diff --git a/Tests/CLITests.swift b/Tests/CLITests.swift
index a3a6e1b..82ce993 100644
--- a/Tests/CLITests.swift
+++ b/Tests/CLITests.swift
@@ -31,6 +31,56 @@ final class OptionsTests: XCTestCase {
     }
   }
 
+  func testParse_AccessibilityDefaultsRemainUnchanged() throws {
+    let options = try Options.parse(["_", "keygen"])
+    XCTAssertEqual(.whenUnlocked, options.accessibility)
+    XCTAssertEqual(.anyBiometryOrPasscode, options.accessControl)
+    let explicit = try Options.parse([
+      "_", "keygen", "--accessibility=when-unlocked", "--access-control=any-biometry",
+    ])
+    XCTAssertEqual(.whenUnlocked, explicit.accessibility)
+    XCTAssertEqual(.anyBiometry, explicit.accessControl)
+  }
+
+  func testParse_AfterFirstUnlockRequiresExplicitNoneInEitherOrder() throws {
+    for arguments in [
+      ["_", "keygen", "--accessibility=after-first-unlock", "--access-control=none"],
+      ["_", "keygen", "--access-control", "none", "--accessibility", "after-first-unlock"],
+    ] {
+      let options = try Options.parse(arguments)
+      XCTAssertEqual(.afterFirstUnlock, options.accessibility)
+      XCTAssertEqual(.none, options.accessControl)
+    }
+    for access in [nil, "passcode", "any-biometry", "any-biometry-or-passcode",
+      "any-biometry-and-passcode", "current-biometry", "current-biometry-and-passcode"] {
+      var args = ["_", "keygen", "--accessibility=after-first-unlock"]
+      if let access = access { args.append("--access-control=" + access) }
+      XCTAssertThrowsError(try Options.parse(args)) { error in
+        XCTAssertEqual(KeyAccessibility.Error.afterFirstUnlockRequiresNone,
+          error as! KeyAccessibility.Error)
+      }
+    }
+  }
+
+  func testParse_InvalidOrMissingAccessibility() throws {
+    XCTAssertThrowsError(try Options.parse(["_", "keygen", "--accessibility=always"])) { error in
+      XCTAssertEqual(Options.Error.invalidValue("--accessibility", "always"), error as! Options.Error)
+    }
+    XCTAssertThrowsError(try Options.parse(["_", "keygen", "--accessibility"])) { error in
+      XCTAssertEqual(Options.Error.missingValue("--accessibility"), error as! Options.Error)
+    }
+    XCTAssertThrowsError(try Options.parse(["_", "recipients", "--accessibility=after-first-unlock"])) { error in
+      XCTAssertEqual(Options.Error.requiresKeygen("--accessibility"), error as! Options.Error)
+    }
+  }
+
+  func testHelpDocumentsAccessibilityAndFirstUnlockRequirement() {
+    XCTAssertTrue(Options.help.contains("--accessibility ACCESSIBILITY"))
+    XCTAssertTrue(Options.help.contains("Default: when-unlocked"))
+    XCTAssertTrue(Options.help.contains("requires --access-control=none"))
+    XCTAssertTrue(Options.help.contains("first unlock requirement"))
+  }
