+/// Accessibility is encoded in a new Secure Enclave key, never a decryption override.
+enum KeyAccessibility: String {
+  case whenUnlocked = "when-unlocked"
+  case afterFirstUnlock = "after-first-unlock"
+
+  enum Error: LocalizedError, Equatable {
+    case afterFirstUnlockRequiresNone
+
+    var errorDescription: String? {
+      return "after-first-unlock requires --access-control=none"
+    }
+  }
+
+  func validate(accessControl: KeyAccessControl) throws {
+    if self == .afterFirstUnlock && accessControl != .none {
+      throw Error.afterFirstUnlockRequiresNone
+    }
+  }
+
+  #if !os(Linux) && !os(Windows)
+    var protection: CFString {
+      switch self {
+      case .whenUnlocked: return kSecAttrAccessibleWhenUnlockedThisDeviceOnly
+      case .afterFirstUnlock: return kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+      }
+    }
+  #endif
+}
