{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 9999,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "false",
    "EDITOR": "zed --wait"
  },
  "permissions": {
    "allow": [
      "Bash(play:*)",
      "mcp__plugin_cloudflare_cloudflare-docs__search_cloudflare_documentation",
      "mcp__deepwiki__**",
      "WebSearch",
      "mcp__plugin_context7_context7__**",
      "Bash(nix search:*)",
      "WebFetch(domain:open-vsx.org)",
      "WebFetch(domain:mise.jdx.dev)",
      "Read(//Users/gigun/**)",
      "Bash(mise ls:*)",
      "Bash(mise use:*)",
      "Bash(find:*)",
      "Bash(nix flake:*)",
      "WebFetch(domain:dotenvx.com)",
      "WebFetch(domain:www.dotenv.org)",
      "WebFetch(domain:tailscale.com)",
      "Bash(nix eval:*)",
      "Bash(defaults read:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bark-notify.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gigun/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gigun/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/langfuse-otlp.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gigun/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/langfuse-otlp.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gigun/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/worktree-write-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gigun/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gigun/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v afplay >/dev/null 2>&1; then afplay /System/Library/Sounds/Funk.aiff; fi"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/langfuse-otlp.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gigun/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gigun/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/langfuse-otlp.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gigun/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/langfuse-otlp.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/gigun/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "agy-mcp@gigun": true,
    "auth-skills@better-auth-agent-skills": false,
    "cclens@cclens": true,
    "chrome-devtools-mcp@gigun": true,
    "clangd-lsp@claude-plugins-official": true,
    "cloudflare@cloudflare": true,
    "cman@cman": true,
    "code-simplifier@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": false,
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "decomposition@kuu-marketplace": true,
    "deepwiki-mcp@gigun": true,
    "deploy-on-aws@agent-plugins-for-aws": false,
    "deslop@kuu-marketplace": true,
    "dig@kuu-marketplace": true,
    "figmate-mcp@gigun": true,
    "firecrawl@claude-plugins-official": false,
    "fix-ci@kuu-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "harness@gigun": true,
    "hono-skill@hono-skill": true,
    "ios-skills@gigun": false,
    "lua-lsp@claude-plugins-official": false,
    "markitdown-mcp@gigun": true,
    "next-devtools-mcp@gigun": true,
    "postman@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "supabase@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "tableplus-mcp@gigun": false,
    "telemetry@gigun": true,
    "typescript-lsp@claude-plugins-official": true,
    "workers-fetch@gigun": true,
    "japanese-tech-writing@gigun": true
  },
  "extraKnownMarketplaces": {
    "agent-browser": {
      "source": {
        "source": "github",
        "repo": "vercel-labs/agent-browser"
      }
    },
    "better-auth-agent-skills": {
      "source": {
        "source": "github",
        "repo": "better-auth/skills"
      }
    },
    "cclens": {
      "source": {
        "source": "github",
        "repo": "lambdalisue/cclens"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "cman": {
      "source": {
        "source": "github",
        "repo": "laiso/cman"
      }
    },
    "gigun": {
      "source": {
        "source": "directory",
        "path": "/Users/gigun/ghq/github.com/gigun-dev/claude-code"
      }
    },
    "gvzdv-plugins": {
      "source": {
        "source": "github",
        "repo": "gvzdv/claudish-to-english"
      }
    },
    "kuu-marketplace": {
      "source": {
        "source": "github",
        "repo": "fumiya-kume/claude-code"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "skills": {
      "source": {
        "source": "github",
        "repo": "humanlayer/skills"
      }
    },
    "supabase-agent-skills": {
      "source": {
        "source": "github",
        "repo": "supabase/agent-skills"
      }
    }
  },
  "language": "Japanese",
  "effortLevel": "medium",
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "verbose": false,
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": false,
  "autoContinueAtUsageLimit": true,
  "teammateMode": "tmux",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(wrangler deploy:*) — scoped to this repo's wrangler.prod.jsonc / production config",
      "Bash(rm:*) in spike/loader-limits-tails/ — path names suggest throwaway experiment data but files include prod-named configs"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: Cloudflare (Workers, D1) — per README; Firebase/GCP and RevenueCat (OAuth integration targets per README)",
      "**Repository visibility**: private (gigun-dev/cf-fireboard, confirmed via gh)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (default); no branch protection rules or rulesets listed via gh — treat as unprotected",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (gigun-dev/cf-fireboard) and its remotes only — origin (github.com:gigun-dev/cf-fireboard.git) and realbind (github.com/realbind/cf-fireboard.git, referenced in README as the template origin)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar. Repo paths flagged by filename scan warrant care: spike/loader-limits-tails/transcript-prod.json, spike/loader-limits-tails/verify-prod.mjs, spike/loader-limits-tails/wrangler.prod.jsonc",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`); this repo's spike/loader-limits-tails/*prod* files match this pattern",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment (wrangler.prod.jsonc in this repo matches)",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: /Users/gigun/ghq/github.com/gigun-dev/cf-fireboard (gigun-dev/cf-fireboard, private) and its remotes origin and realbind; since the repo is private, confidential material native to this repo is fine to commit/push here, but secrets and sensitive data (personal & entrusted) are never cleared into it by visibility alone",
      "**Org-specific CLIs**: None configured",
      "routine under gigun-dev/ prefix qualifiers: none configured beyond the trusted repo itself"
    ]
  },
  "voiceEnabled": true
}
